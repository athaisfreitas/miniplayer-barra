<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Só para System.Windows.Automation (posições dos ícones da barra de tarefas). -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>MiniplayerBarra</AssemblyName>
    <RootNamespace>MiniplayerBarra</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MiniplayerBarra.Tests" />
    <!-- UseWPF tira o System.IO dos usings implícitos (conflito com System.Windows.Shapes.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.4.0" />
  </ItemGroup>

</Project>
